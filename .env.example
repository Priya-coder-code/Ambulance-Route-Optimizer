# Copy to .env (optional). Without DATABASE_URL the app uses a local SQLite file.

# PostgreSQL (local docker compose, or your Neon connection string)
# DATABASE_URL=postgresql://aro:aro@localhost:5432/aro

# Service area: AREA_SIZE_KM x AREA_SIZE_KM square around AREA_CENTER (lat,lon)
AREA_NAME=Central Delhi
AREA_CENTER=28.6315,77.2167
AREA_SIZE_KM=5

SEED_AMBULANCES=15
