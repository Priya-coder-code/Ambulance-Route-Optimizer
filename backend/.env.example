# Copy this file to backend/.env and change what you need.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://aro:aro@localhost:5432/aro

# Service area: a square of AREA_SIZE_KM x AREA_SIZE_KM around AREA_CENTER (lat,lon)
AREA_NAME=Central Delhi
AREA_CENTER=28.6315,77.2167
AREA_SIZE_KM=50
# Tip: AREA_SIZE_KM=15 makes the first download much faster while you develop.

# Offline: build the road graph from a .osm file exported from openstreetmap.org instead
# ROAD_GRAPH_OSM_FILE=sample_data/sample_town.osm

# Simulation
SEED_AMBULANCES=30
HOSPITAL_CANDIDATES=5
RANDOM_SEED=42

# Nominatim requires an identifying User-Agent
USER_AGENT=AmbulanceRouteOptimizer/2.0 (student ADA project)
